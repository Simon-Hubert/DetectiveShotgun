  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4bda3114c086f2c47bc6c89832dc4511, type: 3}
  m_Name: 
  m_EditorClassIdentifier: DShotgun.Dialogs::DShotgun.Dialogs.DialogFrame
  _leftRef:
    _characterId: 7
    _spriteId: 18
  _middleRef:
    _characterId: 0
    _spriteId: 0
  _rightRef:
    _characterId: 3
    _spriteId: 7
  _speakingCharacterID: 0
  _text:
    _text: " .<wait=0,1>.<wait=0,1>. <wait=0,1>Un conseil de journaliste. <wait=0,25>Ceux
      qui ont des choses \xE0 cacher n\u2019\xE9crivent pas \xE0 l\u2019encre. Mes
      sources m\u2019\xE9crivent au jus de citron : \xE7a se voit pas, jusqu\u2019\xE0
      ce qu\u2019on passe une flamme dessous."
    _styles: []
  _moveNextAutomatically: 0
  _useCustomName: 0
  _name: 
  _useCustomDialogProfile: 0
  _characterDialogProfile: {fileID: 0}
