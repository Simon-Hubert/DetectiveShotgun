    _characterId: 3
    _spriteId: 7
  _speakingCharacterID: 2
  _text:
    _text: "Je sais. <wait=0,1>Par moi. <wait0,1>Ta carte disait <i>\u201Ctous les
      soirs\u201D</i>."
    _styles: []
  _moveNextAutomatically: 0
