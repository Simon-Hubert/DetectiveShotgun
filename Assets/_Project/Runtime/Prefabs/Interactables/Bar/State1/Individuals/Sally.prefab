--- !u!114 &4532968749762289552
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8469810357136660815}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4bda3114c086f2c47bc6c89832dc4511, type: 3}
  m_Name: 
  m_EditorClassIdentifier: DShotgun.Dialogs::DShotgun.Dialogs.DialogFrame
  _leftRef:
    _characterId: 7
    _spriteId: 18
  _middleRef:
    _characterId: 0
    _spriteId: 0
  _rightRef:
    _characterId: 3
    _spriteId: 7
  _speakingCharacterID: 0
  _text:
    _text: "<b>Ouvre les yeux, Shotgun.</b> <wait=0,25>Ton tueur prend son temps,
      <wait=0,1>il signe, <wait=0,1>il t\u2019\xE9crit sur les murs. Il veut un public,
      et son public, c\u2019est toi. Quelqu\u2019un qui aime les lames,<wait=0,1>
      qui aime qu\u2019on le regarde, <wait=0,1>et qui sait exactement o\xF9 tu vas
      passer."
    _styles: []
  _moveNextAutomatically: 0
  _useCustomName: 0
  _name: 
  _useCustomDialogProfile: 0
  _characterDialogProfile: {fileID: 0}
