  _text:
    _text: "J\u2019ai accept\xE9 beaucoup de choses lors de vos enqu\xEAtes...<wait=0,5>
      vos m\xE9thodes d\u2019interrogatoires douteuses,<wait=0,25> le poisson rouge
      lors de l\u2019affaire du Poin\xE7onneur des Lilas,<wait=0,25> Lucie \xE0 la
      r\xE9ception...<wait=0,5> MAIS PRENDRE EN CHASSE PRESENTATEUR PATRICE ET ATTEINDRE
      A SA VIE ???"
    _styles: []
  _name: Commissaire
  _moveNextAutomatically: 0
