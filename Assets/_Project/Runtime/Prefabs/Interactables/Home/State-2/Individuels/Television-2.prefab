  _rightRef:
    _characterId: 4
    _spriteId: 9
  _speakingCharacterID: 2
  _text:
    _text: "Non, non Shotgun, tu ne peux pas fuir la v\xE9rit\xE9. Ce jour l\xE0
      tu as bien tu\xE9 Ingrid, ta fianc\xE9e, dans le couloir faisant face \xE0
      l\u2019armurerie de ton plein gr\xE9 pour prendre sa place."
    _styles: []
  _moveNextAutomatically: 0
  _useCustomName: 0
  _name: 
  _useCustomDialogProfile: 0
  _characterDialogProfile: {fileID: 0}
