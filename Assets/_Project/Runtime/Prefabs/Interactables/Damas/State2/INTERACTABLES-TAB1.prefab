  <CharacterDialogProfile>k__BackingField: {fileID: 11400000, guid: 9452b6d7898d6504db4569b36c47db86, type: 2}
  _left: {fileID: -3593096494950662801, guid: 060bdc81261a8584489f0054ff01d863, type: 3}
  _middle: {fileID: 0}
  _right: {fileID: 21300000, guid: 13aadb8d39a86b83b956ed926a30f4b4, type: 3}
  _text:
    _text: "Je suppose que vous \xEAtes venus ici car vous me soup\xE7onnez.. n\u2019est-ce
      pas ? Je suis litt\xE9ralement le seul de la ville \xE0 poss\xE9der autant
      de couteau de collection et exprimant une haine visc\xE9rale envers les armes
      \xE0 feu \xE0 chaque fois que je suis \xE0 l\u2019antenne sur Antenne 3 et-"
    _styles: []
  _name: Damas
  _moveNextAutomatically: 1
