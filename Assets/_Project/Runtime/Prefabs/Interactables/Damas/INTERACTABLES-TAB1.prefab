  <UseCustomName>k__BackingField: 0
  <UseCustomDialogProfile>k__BackingField: 0
  <SpeakingCharacterID>k__BackingField: 2
  <CharacterDialogProfile>k__BackingField: {fileID: 11400000, guid: 9452b6d7898d6504db4569b36c47db86, type: 2}
  _left: {fileID: 7646492065788740202, guid: 8a76f9568d6a57f4688c36f564682b5d, type: 3}
  _middle: {fileID: 0}
  _right: {fileID: 21300000, guid: 13aadb8d39a86b83b956ed926a30f4b4, type: 3}
  _text:
    _text: "Enchant\xE9 ! Je crois oui ? Enfin je sais pas, je m\u2019en fous un
      peu mais, sympa tout ces couteaux ! Attention quand m\xEAme car je crois qu\u2019un
      meurtre a eu lieu cette nuit impliquant un couteau... couteau assez particulier..."
    _styles: []
  _name: Detective
  _moveNextAutomatically: 0
