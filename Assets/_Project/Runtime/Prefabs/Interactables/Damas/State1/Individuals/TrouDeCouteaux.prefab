  _speakingCharacterID: 0
  _text:
    _text: "<big>VOUS !</big> <wait=0,5>N\u2019est-ce pas ?<wait=0,25> C\u2019est
      bien pour \xE7a que vous vous int\xE9ressez autant au sujet des couteaux et
      que vous animez l\u2019\xE9mission de Damas n\u2019est-ce pas ??<wait=0,5>
