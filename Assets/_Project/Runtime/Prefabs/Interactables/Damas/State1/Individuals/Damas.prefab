    _spriteId: 33
  _speakingCharacterID: 2
  _text:
    _text: "Enchant\xE9 mon cher Shotgun. <wait=0,5>Il me semble qu\u2019on s\u2019est
      d\xE9j\xE0 crois\xE9 plusieurs fois dans les loges ou dans la r\xE9gie de Antenne
      3, <wait=0,25>vu que votre \xE9mission est souvent programm\xE9e juste avant
      la mienne... <wait=0,25>en prime time..."
    _styles: []
