  m_Name: 
  m_EditorClassIdentifier: DShotgun.Dialogs::DShotgun.Dialogs.DialogFrame
  _leftRef:
    _characterId: 12
    _spriteId: 33
  _middleRef:
    _characterId: 11
    _spriteId: 30
  _rightRef:
    _characterId: 3
    _spriteId: 7
  _speakingCharacterID: 2
  _text:
    _text: "VOUS ! N\u2019est-ce pas ? C\u2019est bien pour \xE7a que vous vous int\xE9ressez
      autant au sujet des couteaux et que vous animez l\u2019\xE9mission de Damas
      n\u2019est-ce pas ?? J\u2019ai lu clair dans votre jeu ! Haut les mains peau
      de lapin ! Je vous embarque !!"
    _styles: []
  _moveNextAutomatically: 0
  _useCustomName: 0
  _name: 
  _useCustomDialogProfile: 0
  _characterDialogProfile: {fileID: 0}
