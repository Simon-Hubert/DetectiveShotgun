    _spriteId: 7
  _speakingCharacterID: 0
  _text:
    _text: "Enchant\xE9 mon cher Shotgun. Il me semble qu\u2019on s\u2019est d\xE9j\xE0
      crois\xE9 plusieurs fois dans les loges ou dans la r\xE9gie de Antenne 3, vu
      que votre \xE9mission est souvent programm\xE9e juste avant la mienne... en
      prime time..."
    _styles: []
  _moveNextAutomatically: 1
