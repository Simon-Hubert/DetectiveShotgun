  <CharacterDialogProfile>k__BackingField: {fileID: 11400000, guid: 9452b6d7898d6504db4569b36c47db86, type: 2}
  _left: {fileID: 21300000, guid: 13aadb8d39a86b83b956ed926a30f4b4, type: 3}
  _middle: {fileID: 0}
  _right: {fileID: 1490959984544472221, guid: ef07edf783e1f7a57b48ac56f46fe5f1, type: 3}
  _text:
    _text: "D\u2019accord, retrouves moi demain soir au bar apr\xE8s ton service.
      Que je m\u2019assure que tu n\u2019aies pas encore une fois tout compris de
      travers et que tu coin\xE7es la bonne personne. Souviens toi, mon travail d\xE9pend
      de ton travail !"
    _styles: []
  _name: Sally
  _moveNextAutomatically: 0
