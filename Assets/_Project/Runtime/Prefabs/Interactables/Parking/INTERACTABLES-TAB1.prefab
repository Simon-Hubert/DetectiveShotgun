--- !u!114 &4902874455885051160
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8257964506679420275}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4bda3114c086f2c47bc6c89832dc4511, type: 3}
  m_Name: 
  m_EditorClassIdentifier: DShotgun.Dialogs::DShotgun.Dialogs.DialogFrame
  _leftRef:
    _characterId: 3
    _spriteId: 7
  _middleRef:
    _characterId: 0
    _spriteId: 0
  _rightRef:
    _characterId: 7
    _spriteId: 18
  _speakingCharacterID: 2
  _text:
    _text: "Tr\xE8s dr\xF4le. <wait=0,25>Ne crois-tu pas que je pr\xE9f\xE8rerais
      \xEAtre dans les bras de Morph\xE9e et de ma copine plut\xF4t que de croupir
      sous la dalle pour quelques clich\xE9s ? Comme tu le sais, mon gagne-pain d\xE9pend
      du tiens."
    _styles: []
  _moveNextAutomatically: 0
  _useCustomName: 0
  _name: 
  _useCustomDialogProfile: 0
  _characterDialogProfile: {fileID: 0}
