  <CharacterDialogProfile>k__BackingField: {fileID: 11400000, guid: 9452b6d7898d6504db4569b36c47db86, type: 2}
  _left: {fileID: 21300000, guid: 13aadb8d39a86b83b956ed926a30f4b4, type: 3}
  _middle: {fileID: 0}
  _right: {fileID: 1490959984544472221, guid: ef07edf783e1f7a57b48ac56f46fe5f1, type: 3}
  _text:
    _text: "Tr\xE8s dr\xF4le. <wait=0,25>Ne crois-tu pas que je pr\xE9f\xE8rerais
      \xEAtre dans les bras de Morph\xE9e et de ma copine plut\xF4t que de croupir
      sous la dalle pour quelques clich\xE9s ? Comme tu le sais, mon gagne-pain d\xE9pend
      du tiens."
    _styles: []
  _name: Sally
  _moveNextAutomatically: 0
