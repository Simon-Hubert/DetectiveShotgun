  m_Script: {fileID: 11500000, guid: 4bda3114c086f2c47bc6c89832dc4511, type: 3}
  m_Name: 
  m_EditorClassIdentifier: DShotgun.Dialogs::DShotgun.Dialogs.DialogFrame
  <LeftRef>k__BackingField:
    _characterName: Sally
    _spriteName: Idle
  <MiddleRef>k__BackingField:
    _characterName: None
    _spriteName: None
  <RightRef>k__BackingField:
    _characterName: Detective
    _spriteName: Idle
  <UseCustomName>k__BackingField: 0
  <UseCustomDialogProfile>k__BackingField: 0
  <SpeakingCharacterID>k__BackingField: 2
  <CharacterDialogProfile>k__BackingField: {fileID: 11400000, guid: 9452b6d7898d6504db4569b36c47db86, type: 2}
  _left: {fileID: 1490959984544472221, guid: ef07edf783e1f7a57b48ac56f46fe5f1, type: 3}
  _middle: {fileID: 0}
  _right: {fileID: 265408830610322189, guid: 5e4444e6ef77d80dda56a6604ae8a1f3, type: 3}
  _text:
    _text: "Damas ? Valentin Damas ? Le coutellier sp\xE9cialis\xE9 dans les armes
      blanches antiques ? Et pourquoi dont ? Je l\u2019ai d\xE9j\xE0 crois\xE9 quelques
      fois en coulisses et il m\u2019a l\u2019air d\u2019\xEAtre un brave type. Bon
      je te l\u2019accorde, il est super passionn\xE9 par son sujet et \xE0 l\u2019air
      tout de m\xEAme de remettre en question souvent les fondements de notre soci\xE9t\xE9
      mais au del\xE0 de \xE7a. Un brave type."
    _styles: []
  _name: Detective
  _moveNextAutomatically: 0
