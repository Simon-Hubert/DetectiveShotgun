  _right: {fileID: 1490959984544472221, guid: ef07edf783e1f7a57b48ac56f46fe5f1, type: 3}
  _text:
    _text: "Shotgun. <wait=0,5>Il n\u2019y a qu\u2019\xE0 peu pr\xE8s une seule personne
      s\u2019y connaissant autant sur le sujet des armes blanches et qui serait suspectible
      d\u2019en avoir. R\xE9fl\xE9chis, il intervient sur le m\xEAme plateau que
      toi et Pr\xE9sentateur Patrice, mais \xE0 un autre cr\xE9neau."
    _styles: []
  _name: Sally
  _moveNextAutomatically: 0
