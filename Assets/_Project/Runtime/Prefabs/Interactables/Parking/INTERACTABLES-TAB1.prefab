    _spriteName: Idle
  <UseCustomName>k__BackingField: 0
  <UseCustomDialogProfile>k__BackingField: 0
  <SpeakingCharacterID>k__BackingField: 2
  <CharacterDialogProfile>k__BackingField: {fileID: 11400000, guid: 9452b6d7898d6504db4569b36c47db86, type: 2}
  _left: {fileID: 21300000, guid: 13aadb8d39a86b83b956ed926a30f4b4, type: 3}
  _middle: {fileID: 0}
  _right: {fileID: 1490959984544472221, guid: ef07edf783e1f7a57b48ac56f46fe5f1, type: 3}
  _text:
    _text: "J\u2019ai vraiment besoin de t\u2019expliquer ? C\u2019est la seule personne
      qui en poss\xE8de et conna\xEEt les couteaux aussi bien. Tu penses que la victime
      soit un armurier est si annodin que \xE7a ? Je pense qu\u2019il cherche \xE0
      faire passer un message et \xE0 se jouer de toi."
    _styles: []
  _name: Sally
  _moveNextAutomatically: 0
