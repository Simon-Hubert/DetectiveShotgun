  _right: {fileID: 265408830610322189, guid: 5e4444e6ef77d80dda56a6604ae8a1f3, type: 3}
  _text:
    _text: "Comment \xE7a ? Bien s\xFBr que non attends, on parle bien d\u2019un
      meurtre au couteau. C\u2019est quelque chose de compl\xE8tement inconcevable
      et tu penses que trouver le coupable sera aussi simple ?"
    _styles: []
  _name: Detective
