  _right: {fileID: 265408830610322189, guid: 5e4444e6ef77d80dda56a6604ae8a1f3, type: 3}
  _text:
    _text: "Eh ! Ok c\u2019est bon, t\u2019as gagn\xE9. Bref. Plus s\xE9rieusement,
      on est d\u2019accord que le coupable est tout trouv\xE9 cette fois-ci non ?
      Alors tu fais ce que t\u2019as \xE0 faire et comme d\u2019habitude, je suis
      tout \xE7a de tr\xE8s pr\xE8s."
    _styles: []
  _name: Sally
  _moveNextAutomatically: 0
