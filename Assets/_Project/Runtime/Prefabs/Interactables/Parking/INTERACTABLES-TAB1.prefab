    _spriteId: 0
  _rightRef:
    _characterId: 7
    _spriteId: 18
  _speakingCharacterID: 2
  _text:
    _text: "D\u2019accord, retrouves moi demain soir au bar apr\xE8s ton service.
      <wait=0,25>Que je m\u2019assure que tu n\u2019aies pas encore une fois tout
      compris de travers et que tu coin\xE7es la bonne personne. <wait=0,5>Souviens
      toi, <wait=0,25>mon travail d\xE9pend de ton travail !"
    _styles: []
  _moveNextAutomatically: 0
  _useCustomName: 0
  _name: 
