  _right: {fileID: 1490959984544472221, guid: ef07edf783e1f7a57b48ac56f46fe5f1, type: 3}
  _text:
    _text: "Shotgun, tu pourrais faire un effort, tu n\u2019y es pas all\xE9 de main
      morte sur la sc\xE8ne de crime, qu\u2019est-ce qu\u2019il me reste \xE0 photographier
      pour le journal et la t\xE9l\xE9vision ?"
    _styles: []
  _name: Sally
  _moveNextAutomatically: 0
