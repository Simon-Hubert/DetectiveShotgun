    - target: {fileID: 2972082133930404051, guid: 0a1b11437c878cd4b9b91c197c428b37, type: 3}
      propertyPath: _text._text
      value: "Celle l\xE0 aussi c\u2019est du Made in China ou il l\u2019a simplement
