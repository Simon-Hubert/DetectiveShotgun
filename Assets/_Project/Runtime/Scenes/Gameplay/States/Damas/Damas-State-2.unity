    - target: {fileID: 1460789826923332410, guid: 0a1b11437c878cd4b9b91c197c428b37, type: 3}
      propertyPath: _text._text
      value: "Je vois que Damas a remplac\xE9 le poster que j\u2019ai trou\xE9 par<wait=0,25>.<wait=0,25>.<wait=0,25>.
        <wait=0,75>un poster de Patrice et moi ?"
