  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4bda3114c086f2c47bc6c89832dc4511, type: 3}
  m_Name: 
  m_EditorClassIdentifier: DShotgun.Dialogs::DShotgun.Dialogs.DialogFrame
  <LeftRef>k__BackingField:
    _characterName: Barman Bodolphe
    _spriteName: Idle
  <MiddleRef>k__BackingField:
    _characterName: None
    _spriteName: None
  <RightRef>k__BackingField:
    _characterName: Detective
    _spriteName: Idle
  <UseCustomName>k__BackingField: 0
  <UseCustomDialogProfile>k__BackingField: 0
  <SpeakingCharacterID>k__BackingField: 0
  <CharacterDialogProfile>k__BackingField: {fileID: 11400000, guid: 9452b6d7898d6504db4569b36c47db86, type: 2}
  _left: {fileID: -3497540652011493120, guid: 56b74ccd779d364419582e2ba34c798e, type: 3}
  _middle: {fileID: 0}
  _right: {fileID: 21300000, guid: 13aadb8d39a86b83b956ed926a30f4b4, type: 3}
  _text:
    _text: "Ton copain de la t\xE9l\xE9 a failli y arriver tout \xE0 l\u2019heure.
      M. Damas, <wait=0,1>celui qui signe \xE0 l\u2019envers sur mon ardoise. <wait=0,25>
      Il lui restait 17 et il est parti avant son dernier lancer. <wait=0,25>Monsieur
      avait <i>\u201Cun mot \xE0 \xE9crire\u201D</i>."
    _styles: []
  _name: Barman Bodolphe
  _moveNextAutomatically: 0
