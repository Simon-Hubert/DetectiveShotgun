  _middle: {fileID: 0}
  _right: {fileID: 21300000, guid: 13aadb8d39a86b83b956ed926a30f4b4, type: 3}
  _text:
    _text: "Elle est prise par quelqu\u2019un qui a une heure de retard. <wait=0,2>Et
      c\u2019\xE9tait une info, <wait=0,1>pas une invitation. Si t\u2019as trouv\xE9
      quelque chose sur ton tueur, montre-le. <wait=0,1>Sinon, <b>d\xE9gage</b>."
    _styles: []
  _name: Sally
  _moveNextAutomatically: 0
