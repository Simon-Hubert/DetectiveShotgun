  _right: {fileID: 21300000, guid: 13aadb8d39a86b83b956ed926a30f4b4, type: 3}
  _text:
    _text: "Il a command\xE9 un citron press\xE9, <wait=0,1>l\u2019a pas bu, <wait=0,1>a
      tremp\xE9 un cure-dent dedans et a gribouill\xE9 sur un sous-verre. Puis il
      l\u2019a jet\xE9 dans la poubelle de l\u2019arri\xE8re-salle en me disant :
      <i>\u201CSurtout, que personne n\u2019aille fouiller cette poubelle\"</i>."
    _styles: []
  _name: Barman Bodolphe
  _moveNextAutomatically: 0
